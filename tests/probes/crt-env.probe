1700 rl_crt_4bfa30 32 2 0 0 @s1
1700 rl_crt_4c2080 $s1 "OL2PROBE=one"
1700 rl_crt_4cde70 $s1 0
1700 rl_crt_4ce1e0 "OL2PROBE" 8
1700 rl_crt_4ce1e0 "ol2probe=x" 8
1700 rl_crt_4ce1e0 "NOSUCHVAR" 9
1700 rl_crt_4bfa30 32 2 0 0 @s2
1700 rl_crt_4c2080 $s2 "OL2PROBE=two"
1700 rl_crt_4cde70 $s2 1
1700 rl_crt_4bfa30 32 2 0 0 @s3
1700 rl_crt_4c2080 $s3 "OL2OTHER=3"
1700 rl_crt_4cde70 $s3 1
1700 rl_crt_4cde70 0 0
1700 rl_crt_4cde70 "NOEQUALS" 0
1700 rl_crt_4cde70 "=x" 0
1700 rl_crt_4cde70 "OL2ABSENT=" 1
