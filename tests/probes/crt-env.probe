1700 rl_crt_4ce380 va:0x4e5780
# fclose of a write stream with its own buffer (2 bytes pending) and a _tmpfname: _flush writes, _freebuf frees,
# _close, the name freed. _base = B (parse_cmdline argv = &_base), _ptr = B + 2 (argv = &_iob[4]._tmpfname: argv[1]
# lands on _ptr, argv[2] = NULL on _cnt), _tmpfname = T (argv[1] = NULL on _iob[6]._ptr)
1700 rl_crt_4cea50 "ol2probe2.tmp" 0x8302 0x40 0x180 @f2
1700 rl_crt_4bfa30 16 2 0 0 @buf
1700 rl_crt_4bfa30 16 2 0 0 @tmp
1700 rl_crt_4c9570 "x" va:0x4e5788 $buf buf:4 buf:4
1700 rl_crt_4c9570 "q xyz" va:0x4e577c $buf buf:4 buf:4
1700 rl_crt_4c9570 "t" va:0x4e579c $tmp buf:4 buf:4
1700 rl_crt_4c2200 va:0x4e577c 0 4
1700 rl_crt_4c2200 va:0x4e578c 0x0a 1
1700 rl_crt_4c2200 va:0x4e5790 $f2 1
1700 rl_crt_4ce380 va:0x4e5780
1700 rl_crt_4cf490 $f2
