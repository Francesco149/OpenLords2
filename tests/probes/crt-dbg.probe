1700 rl_crt_4ca5d0 -1 buf:40 16
1700 rl_crt_4ca5d0 0 buf:40 10
1700 rl_crt_4ca5d0 255 buf:40 2
1700 rl_crt_4ca5d0 123456789 buf:40 36
1700 rl_crt_4ca5d0 2147483647 buf:40 10
1700 rl_crt_4ca630 0x80000000 buf:40 10 1
1700 rl_crt_4ca630 7 buf:40 8 0
1700 rl_crt_4ca630 35 buf:40 36 0

# _snprintf / _vsnprintf: fits, exact fit, no room for the terminator, overflow (→ _flsbuf on the string stream)
1700 rl_crt_4ca900 buf:64 64 "%s=%d %x|%5.3s" "key" -17 0xbeef "abcdef"
1700 rl_crt_4ca900 buf:16 5 "abcd"
1700 rl_crt_4ca900 buf:16 4 "abcd"
1700 rl_crt_4ca900 buf:16 8 "%s" "too long for it"
1700 rl_crt_4ca900 buf:16 0 ""
1700 rl_crt_4ca9f0 buf:32 32 "%d|%d|%c" "\x07\x00\x00\x00\xfe\xff\xff\xff\x41\x00\x00\x00"
1700 rl_crt_4ca9f0 buf:8 3 "%d" "\x39\x30\x00\x00"

