1700 rl_crt_4c6650 0x41 va:0x4e5780
# read at EOF, a user buffer: back to its start, nothing to flush (fd -1: __badioinfo, no FAPPEND) → ch
1700 poke 0x4e5780 0x4e57a5 3 0x4e57a0 0x191 -1 0 32 0
1700 rl_crt_4c6650 0x1c2 va:0x4e5780
