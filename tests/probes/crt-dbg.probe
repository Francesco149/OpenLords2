1700 poke 0x4e5780 0x4e579c 0 0x4e57a0 0x102 -1 0 32 0
1700 rl_crt_4c6650 0x43 va:0x4e5780
# unbuffered (_IONBF) on fd -1 → -1
1700 poke 0x4e5780 0 0 0 0x6 -1 0 0 0
1700 rl_crt_4c6650 0x44 va:0x4e5780
# stdout (fd -1, not a tty): _getbuf, ch stored → ch; again: the 1 byte flushed to fd -1 fails → -1
