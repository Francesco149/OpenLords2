#!/usr/bin/env bash
# pre-commit hook — keeps the derived port ledger current and runs the
# host regression suite BEFORE a commit lands, converting the project's
# "agent remembers to run make" convention into an enforced gate.
#
#   1. Regenerate the derived port ledger (STATUS.md, port-ledger.{json,md})
#      and stage it so it always tracks HEAD with zero manual steps.
#   2. If any C source/header or test changed, build + run the host
#      ASan/UBSan unit suite and abort the commit on failure.
#   3. If rhost, the port sources or a scenario changed, run the rhost corpus
#      gate on wine (local, ~15 s): every TRACKED (or staged) scenario must still
#      match its blessed expected.wine.json (state hash + every presented frame);
#      another agent's untracked work-in-progress games are not the commit's.
#      Port sources changed → also the standalone (corpus --check --standalone --port-data: no retail code, .rdata /
#      .data from the port's own definitions (data_selfcheck.py --compose --strict), = the bless).
#
# Bypass for an emergency / WIP commit:  git commit --no-verify
# Installed via core.hooksPath=tools/git-hooks.

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# dev-shell wrapper — python3/make live in the dev shell on this host. tools/dev sources a cached
# `nix print-dev-env` instead of keeping a `nix develop` evaluator (~370 MB) resident per command.
run() { tools/dev "$@"; }

# per-invocation logs: parallel agents (worktrees) commit at the same time
LOGD=$(mktemp -d /tmp/ol2_precommit.XXXXXX)
trap 'rm -rf "$LOGD"' EXIT

# --- 1. Regenerate + stage the derived ledger ----------------------------
if run python3 tools/gen_port_ledger.py >"$LOGD/ledger.log" 2>&1; then
    git add docs/STATUS.md docs/port-ledger.json docs/port-ledger.md 2>/dev/null || true
else
    echo "pre-commit: port-ledger generation failed:" >&2
    tail -20 "$LOGD/ledger.log" >&2
    exit 1
fi

# --- 1b. The VA → rl_ map follows rhost's row tables ----------------------
if ! python3 tools/gen_rl_va_map.py --check 2>/dev/null; then
    python3 tools/gen_rl_va_map.py >/dev/null && git add src/rl_va_map.c
    echo "pre-commit: src/rl_va_map.c regenerated from the row tables (staged)" >&2
fi
# --- 1c. The port's image description (layout + imports) = the exe's -------
if [ -e src/rl_image.c ] && ! python3 tools/gen_image_defs.py --check >/dev/null 2>&1; then
    echo "pre-commit: src/rl_image.{c,h} differ from the exe (tools/gen_image_defs.py --check)" >&2; exit 1
fi

# --- 2. Run the host test suite if code changed --------------------------
staged="$(git diff --cached --name-only)"
if echo "$staged" | grep -qE '^(src/|tests/).*\.(c|h)$'; then
    echo "pre-commit: C sources changed → building + running host suite..."
    if ! run make -C tests run >"$LOGD/tests.log" 2>&1; then
        echo "pre-commit: host test suite FAILED — commit aborted:" >&2
        tail -30 "$LOGD/tests.log" >&2
        echo "(bypass with: git commit --no-verify)" >&2
        exit 1
    fi
    echo "pre-commit: $(grep -oE '[0-9]+ passed' "$LOGD/tests.log" | tail -1)"
    # the standalone links every src/*.c (partitions' generated globals can collide: tools/bf/dedup_globals.py)
    if ! run make -C src -j8 >"$LOGD/standalone.log" 2>&1; then
        echo "pre-commit: the standalone build FAILED — commit aborted:" >&2
        grep -E "error|multiple definition" "$LOGD/standalone.log" | head -10 >&2
        exit 1
    fi
    echo "pre-commit: standalone build OK"
fi

# --- 3. Render edits: the proof is a hybrid replace + fb chain ---------------
if echo "$staged" | grep -qE '^src/(gfx_|engine_.*_render|engine_overlay|engine_map|engine_battlefield).*\.(c|h)$'; then
    echo "pre-commit: render files changed — prove them with rhost: corpus --check --hook replace:NAME" >&2
    echo "            (every presented frame) and eyeball with rhost.py view … --b-hook replace:NAME." >&2
fi

# --- 4. rhost corpus gate (wine, local) --------------------------------------
if echo "$staged" | grep -qE '^(src/.*\.(c|h)|tools/rhost/.*\.(c|h|x|sh)|tools/rhost/rhost\.py|tests/scenarios/.*)$'; then
    echo "pre-commit: rhost corpus --check (wine)..."
    # port sources changed: the standalone (no retail code) must equal the blessed corpus too (--standalone)
    SA=""; echo "$staged" | grep -qE '^src/.*\.(c|h)$' && SA="--standalone --port-data"
    if ! python3 tools/rhost/rhost.py corpus --check $SA --tracked --target wine >"$LOGD/rhost_gate.log" 2>&1; then
        echo "pre-commit: rhost corpus gate FAILED — commit aborted:" >&2
        grep -E "FAIL|NO expected|NO RESULT|FATAL" "$LOGD/rhost_gate.log" | tail -20 >&2
        echo "(an intended change: re-bless with rhost.py corpus --bless [--target wine]; bypass: git commit --no-verify)" >&2
        exit 1
    fi
    echo "pre-commit: $(grep -E 'STANDALONE CHECK|CORPUS CHECK' "$LOGD/rhost_gate.log" | tr '\n' ' ')"
fi

exit 0
