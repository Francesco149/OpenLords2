#!/usr/bin/env bash
# post-commit hook — pre-commit regenerates the derived ledger into the commit; with a pathspec commit
# (`git commit -- paths`, what agents sharing the index use) git then updates the real index for the named
# paths only, so the ledger files stay staged at their OLD content ("MM") and a later plain commit would
# revert them. Re-sync them with what was just committed.
cd "$(git rev-parse --show-toplevel)"
for f in docs/STATUS.md docs/port-ledger.json docs/port-ledger.md; do
    if git diff --quiet HEAD -- "$f" 2>/dev/null; then git reset -q HEAD -- "$f" 2>/dev/null || true; fi
done
exit 0
