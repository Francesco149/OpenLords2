#!/usr/bin/env bash
# tools/dev CMD [ARGS...] — run CMD in the project's dev environment without a resident `nix develop`.
#
# `nix develop -c CMD` keeps its evaluator (~370 MB RSS) alive for as long as CMD runs. On 2026-10-23 two
# agents' long verifies plus nested builds held 22 of them (8 GB) when maximus (31 GB, no swap) ran out of
# memory. This caches `nix print-dev-env` once per flake.nix + flake.lock and sources it: CMD runs under plain
# bash with the same toolchain, Python and shellHook exports. Already inside the dev shell: runs CMD as is.
set -o pipefail
ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
[ -n "${IN_NIX_SHELL:-}" ] && exec "$@"
key=$(cat "$ROOT/flake.nix" "$ROOT/flake.lock" | sha256sum | cut -c1-16)
cache=${XDG_CACHE_HOME:-$HOME/.cache}/openlords2/devenv-$key.sh
if [ ! -s "$cache" ]; then
    mkdir -p "$(dirname "$cache")"
    (cd "$ROOT" && nix print-dev-env) > "$cache.$$" || { rm -f "$cache.$$"; echo "tools/dev: nix print-dev-env failed" >&2; exit 1; }
    mv -f "$cache.$$" "$cache"
fi
here=$PWD
cd "$ROOT" && source "$cache" >/dev/null 2>&1   # the shellHook takes OPENLORDS2_ROOT from $PWD
cd "$here" || exit 1
"$@"; rc=$?
[ -n "${NIX_BUILD_TOP:-}" ] && [ -d "$NIX_BUILD_TOP" ] && rm -rf "$NIX_BUILD_TOP"   # print-dev-env's per-shell temp dir
exit $rc
