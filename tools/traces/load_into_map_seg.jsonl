# Segtrace smoke test (TAS framework P2): the load_into_map flow expressed on
# the anchor-segmented timeline.  Validates {wait}/{capture} + anchor-relative
# capture end-to-end.  Drives: title menu → Single player → Your options →
# Load a game → Load lastturn.sav → strategic map.
#
# Run (turbo): nix develop -c python3 -u tools/frida_capture.py
#   --remote $OPENLORDS2_FRIDA_REMOTE --skip-intro --turbo --anchor-trace
#   --input-segtrace tools/traces/load_into_map_seg.jsonl --run-id seg-smoke1
#
# Coords GAME space (640x480); lParam=(y<<16)|x.  Within the TITLE segment, t
# is RELATIVE to the TITLE anchor frame (rebased by {wait}).
{"wait": "TITLE"}
{"t": 60, "m": 512, "w": 0, "l": 7012672}
{"t": 66, "m": 512, "w": 0, "l": 7012672}
{"t": 70, "m": 513, "w": 1, "l": 7012672}
{"t": 76, "m": 514, "w": 0, "l": 7012672}
{"t": 200, "m": 512, "w": 0, "l": 9109824}
{"t": 206, "m": 512, "w": 0, "l": 9109824}
{"t": 210, "m": 513, "w": 1, "l": 9109824}
{"t": 216, "m": 514, "w": 0, "l": 9109824}
{"t": 400, "m": 512, "w": 0, "l": 5898654}
{"t": 406, "m": 512, "w": 0, "l": 5898654}
{"t": 410, "m": 513, "w": 1, "l": 5898654}
{"t": 416, "m": 514, "w": 0, "l": 5898654}
# The t=416 LBUTTONUP clicks "Load" and kicks the (non-deterministic) save
# load.  Span it with a wait — the counter rebases onto the map frame.  Any
# post-load input belongs AFTER this wait (input scheduled past the anchor
# frame would block the cursor from ever reaching the wait).
{"wait": "MAP_FREEROAM"}
{"capture": 2, "label": "map_enter"}
{"capture": 60, "label": "map_settled"}
